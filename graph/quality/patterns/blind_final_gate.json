  "max_instances": 12,
  "required_operations": [
    "blind_final_intent",
    "blind_final_correctness",
    "blind_final_counterexample",
    "blind_final_reproduction",
    "blind_final_simplicity",
    "blind_final_domain",
    "release_gate"
  ]
}
